# 复制为 .env 后按需修改
#   cp .env.example .env

# 工作台对外端口（浏览器访问 http://<主机IP>:<APP_PORT>/）
APP_PORT=8080

# PostgreSQL 凭据 —— 上线前务必改掉默认密码
DB_NAME=workbench
DB_USER=workbench
DB_PASSWORD=workbench123

# 启动时是否自动执行 Alembic 迁移到最新版本
#   1 = 自动（推荐，容器一启动就是最新表结构）
#   0 = 不自动，需要自己进容器跑 alembic upgrade head
AUTO_MIGRATE=1

# 是否自动灌入演示数据
#   1 = 灌入（首次试用/演示用）
#   0 = 不灌入，从空白台账开始（正式上线必须 0）
# 单独补演示数据：docker compose run --rm app python -m app.seed --demo
SEED_DEMO=0

# 初始管理员。仅在库中没有任何管理员时创建。
#   ADMIN_PASSWORD 留空 = 随机生成 12 位密码并打印到容器日志：
#   docker compose logs app | grep 初始管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=系统管理员

# 邮箱授权码的可逆加密主密钥。生产必须显式配置，否则邮箱账号无法安全保存。
# 生成方式：openssl rand -hex 32
# ⚠️ 一旦更换，已存的邮箱密码全部解不开，需要重新填写。
MAIL_SECRET=

# 外部收票通道令牌：Agent Mail、邮件网关或自建脚本用
#   POST /api/inbox/ingest  携带 X-Ingest-Token: <该值>
# 留空则关闭该通道（仅保留 IMAP 直连收票）
INBOX_INGEST_TOKEN=

# 交互式接口文档（/docs、/redoc）。生产建议 0
DOCS_ENABLED=0

# 跨域白名单，逗号分隔（如 https://oa.example.com）。前后端同容器时留空
CORS_ORIGINS=

# 单个发票影像文件大小上限（MB）
UPLOAD_MAX_MB=10

# ---------------------------------------------------------------------------
# 本地 OCR（识别拍照件 / 扫描件）
# ---------------------------------------------------------------------------
# 构建时是否安装本地 OCR（RapidOCR + PDFium，约 300MB）。
#   1 = 安装（默认，推荐）：手机拍的照片、扫描版 PDF 都能识别
#   0 = 不装：镜像小很多，但图片类发票只能人工补录
# 改完需要重新构建镜像：docker compose up -d --build
INSTALL_OCR=1

# 运行时选择 OCR 后端
#   auto = 自动（有 RapidOCR 就用它，否则退回 Tesseract）
#   rapidocr / tesseract = 强制指定；off = 关闭
OCR_ENGINE=auto
# 单个 PDF 最多处理的页数（发票基本单页）与栅格化倍率（2.0 兼顾清晰度与耗时）
OCR_MAX_PDF_PAGES=5
OCR_PDF_SCALE=2.0

# ---------------------------------------------------------------------------
# AI 智能（可选）—— 模型 Key 在网页「AI 设置」里配，不用写在这里
# ---------------------------------------------------------------------------
# 服务端访问模型接口要走的代理。内网直连填空；需出网的环境填，如
#   AI_PROXY=http://10.10.10.252:1086
AI_PROXY=

# 模型接口的 HTTPS 证书校验。内网自建网关用自签证书时才设 0，公网务必保持 1
AI_VERIFY_SSL=1

# 模型调用超时（秒）与单次最大输出 tokens。每个模型配置在界面上还能单独覆盖
AI_TIMEOUT_SEC=60
AI_MAX_TOKENS=2048

# 镜像构建时的 pip 源（国内/内网建议保留清华镜像；海外改成 https://pypi.org/simple）
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# 老版本 Docker 引擎（<20.10.10）需要 unconfined，否则线程创建会被 seccomp 拦掉，
# 表现为同步接口全 500 + 容器反复重启。引擎升级到 20.10.10+ 后可改为 default。
# 详见 README「Docker 引擎兼容性」。
SECCOMP_MODE=unconfined

# ---------------------------------------------------------------------------
# 多实例并存 / 离线部署（一般不用改；deploy/install.sh 会按其需要写入）
# ---------------------------------------------------------------------------
# 镜像 tag。离线部署时由安装脚本按包内镜像的实际版本写入，
# 现场构建时可改成任意自定 tag。
IMAGE_TAG=2.9.14

# 容器名与数据卷名。同一台机器上要再起一套（试运行/多分公司）时全部改掉即可，
# 三组名字必须各不相同，否则两套实例会互相踩数据卷。
APP_CONTAINER=reimburse-app
DB_CONTAINER=reimburse-db
PGDATA_VOLUME=reimburse-pgdata
UPLOADS_VOLUME=reimburse-uploads
# 在线升级的工作目录（下载的安装包、升级进展、升级前备份都存这里）
UPGRADE_VOLUME=reimburse-upgrade

# ===== Jev AI 决策（v2.7.9+，可选）=====
# Jev 是 TypeSafe AI 2026 年发布的结构化决策模型（不写文本）。
# 通过 Vercel AI Gateway 接入（早期访问 waitlist）。
# 不配也能用现有 AI；配了就让 Jev 加速分类/路由/异常/重复检测。
JEV_API_KEY=
JEV_BASE_URL=https://ai-gateway.vercel.sh/v1/ai/jev
JEV_TIMEOUT_SEC=8

# ===== 在线升级（v2.9.0+，可选）=====
# 升级源是 GitHub Release，仓库里需要三类资产（deploy/make-package.sh --release 会自动产出）：
#   manifest.json                                  版本清单（含 sha256）
#   reimburse-workbench-<版本>-linux-<架构>.tar.gz   镜像包
#   reimburse-workbench-<版本>-app.tar.gz            骨架包（compose / install.sh / deploy / docs）
# 下面这些也能在界面「系统参数 → 系统更新」里填；界面里配过的优先于这里。
UPGRADE_REPO=
UPGRADE_TOKEN=
UPGRADE_PROXY=
UPGRADE_AUTO_CHECK=0
UPGRADE_INTERVAL_HOURS=6

# Docker socket：容器要能操作宿主 Docker，「一键升级」才可用。
# 各平台位置不同（Linux 多在 /var/run，Docker Desktop 在用户目录下），
# deploy/install.sh 会自动探测并写进来。
# ⚠️ 挂载它等于把宿主机 root 权限交给这个容器，只在完全可信的内网开启；
#    不需要在线升级时，把它指向一个普通的空文件即可关闭。
DOCKER_SOCK=/var/run/docker.sock
# 开启「应用内一键升级」时通常需要 root 连 socket（默认 10001:10001 非 root）：
#APP_USER=0:0

# 宿主上的项目目录（安装包所在目录）：原样挂进容器，
# 升级时用新版本覆盖 compose / install.sh / deploy / docs。
HOST_PROJECT_DIR=
