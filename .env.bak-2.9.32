# 本地部署配置（已加入 .gitignore，不会提交）
APP_PORT=8080

DB_NAME=workbench
DB_USER=workbench
DB_PASSWORD=workbench123

# 启动时自动执行 Alembic 迁移
AUTO_MIGRATE=1

# 演示数据：生产为 0（不灌任何演示数据，只有初始管理员）
SEED_DEMO=0

# 初始管理员。ADMIN_PASSWORD 留空 = 随机生成 12 位密码并打印到容器日志
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DtESad0Dwl
ADMIN_NAME=系统管理员

# 邮箱授权码加密主密钥 —— 生产必须改成自己的随机串（openssl rand -hex 32）
MAIL_SECRET=45f33b2d594e7e638b2aef4543d37ecfef65615995373a9d4ffefcf906a2b316

# 外部收票通道令牌（Agent Mail / 邮件网关投递用），留空则关闭该通道
INBOX_INGEST_TOKEN=3ee605ca31f12bb7c887e7f4adb033fe

# 交互式接口文档（/docs），生产建议关闭
DOCS_ENABLED=0

# 跨域白名单，逗号分隔；前后端同容器留空
CORS_ORIGINS=

# 单个影像文件大小上限（MB）
UPLOAD_MAX_MB=10

# 老版本 Docker 引擎（<20.10.10）需要 unconfined，否则线程创建被 seccomp 拦掉。
# 引擎升级到 20.10.10+ 后可改为 default（恢复默认沙箱），详见 README。
SECCOMP_MODE=unconfined

# 在线升级（v2.9.0+）：容器操作宿主 Docker 用的 socket（deploy/install.sh 会按平台自动探测）
DOCKER_SOCK=/var/run/docker.sock
# 应用内一键升级需要容器能连 Docker socket（socket 通常仅 root 可连）：
APP_USER=0:0
HOST_PROJECT_DIR=/Users/rickey/WorkBuddy/opc/reimburse-workbench
UPGRADE_VOLUME=reimburse-upgrade
IMAGE_TAG=2.9.32
